{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {"src": "/privacy", "dest": "/privacy.html" },
    {"src": "/terms",   "dest": "/terms.html" },
    {"src": "/popia",   "dest": "/popia.html" },
    { "src": "/dpa",      "dest": "/dpa.html" },
    {"src": "/(.*)",    "dest": "/$1" }
  ]
}